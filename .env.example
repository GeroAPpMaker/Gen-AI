# Gemini API key — NEVER commit this file
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model ID (default: gemini-1.5-flash)
# TODO: update this when the target Flash model ID is confirmed
GEMINI_MODEL=gemini-1.5-flash

# Set to true to return canned replies without calling Gemini (for UI testing)
MOCK_CHAT=true

# Server port (default: 3000)
PORT=3000

# Comma-separated allowed origins for CORS (leave empty for localhost only)
# Example: ALLOWED_ORIGINS=https://your-site.com,https://www.your-site.com
ALLOWED_ORIGINS=
